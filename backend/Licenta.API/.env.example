MQTT_HOST=
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=floriva/floriva01/sensors
MQTT_USE_TLS=true

OPENWEATHER_API_KEY=
OPENWEATHER_LATITUDE=
OPENWEATHER_LONGITUDE=
OPENWEATHER_UNITS=metric
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5/

# Npgsql format. Required: the app refuses to start without it.
POSTGRES_CONNECTION_STRING=Host=localhost;Port=5432;Database=floriva;Username=postgres;Password=change-me

# Comma-separated browser origins allowed by CORS. Optional (default: http://localhost:5173).
CORS_ALLOWED_ORIGINS=http://localhost:5173
