MQTT_HOST=
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=floriva/floriva01/sensors
# Optional (default: floriva/floriva01/weight). Must match MQTT_TOPIC_WEIGHT in the firmware.
MQTT_WEIGHT_TOPIC=floriva/floriva01/weight
# Optional (defaults below). Must match MQTT_TOPIC_CMD / MQTT_TOPIC_STATUS in the firmware.
MQTT_COMMAND_TOPIC=floriva/floriva01/cmd
MQTT_STATUS_TOPIC=floriva/floriva01/status
MQTT_USE_TLS=true

# Optional (default 30). Wait between "Done watering" and "Save wet point". Set 1 for bench tests.
CALIBRATION_DRAIN_MINUTES=30

OPENWEATHER_API_KEY=
OPENWEATHER_LATITUDE=
OPENWEATHER_LONGITUDE=
OPENWEATHER_UNITS=metric
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5/

# Npgsql format. Required: the app refuses to start without it.
POSTGRES_CONNECTION_STRING=Host=localhost;Port=5432;Database=floriva;Username=postgres;Password=change-me

# Comma-separated browser origins allowed by CORS. Optional (default: http://localhost:5173).
CORS_ALLOWED_ORIGINS=http://localhost:5173
